instance visible-reassignment-base {
    domain = visible-reassignment;
    objects {
        source : {s0, s1};
        channel : {c0, c1};
    };
    non-fluents {
        target-map(s0, c1);
        target-map(s1, c0);
    };
    init-state {
        assigned(s0, c0);
        assigned(s1, c1);
        source-value(s0) = 0;
        source-value(s1) = 0;
    };
    max-nondef-actions = 1;
    horizon = 2;
    discount = 1.0;
}
