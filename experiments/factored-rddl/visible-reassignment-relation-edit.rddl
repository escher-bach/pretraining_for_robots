// This differs from the base only in the target relation.  The base's
// post-swap select(s0,c1) is no longer legal, so this is meaning-changing.
instance visible-reassignment-relation-edit {
    domain = visible-reassignment;
    objects {
        source : {s0, s1};
        channel : {c0, c1};
    };
    non-fluents {
        target-map(s0, c0);
        target-map(s1, c1);
    };
    init-state {
        assigned(s0, c0);
        assigned(s1, c1);
        source-value(s0) = 7;
        source-value(s1) = 3;
    };
    max-nondef-actions = 1;
    horizon = 2;
    discount = 1.0;
}
